# Server Configuration
PORT=3000
NODE_ENV=production

# NewsAPI.org API Key (KEEP SECRET ON SERVER ONLY)
API_KEY=your_newsapi_org_api_key_here

# Allowed CORS Origins (Comma-separated URLs)
# Example for production: https://your-app.vercel.app
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
